<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/appointmentTimeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Időpont: 2025-03-26 14:00"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/appointmentMessageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Megjegyzés: Kérem feketével"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/appointmentDetailText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Szalon ID: abc123"
        android:textSize="12sp"
        android:textColor="#888888" />

    <TextView
        android:id="@+id/appointmentStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Státusz: " />

    <Button
        android:id="@+id/cancelAppointmentButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lemondás"
        android:visibility="gone" />


</LinearLayout>